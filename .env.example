# Copy to .env and fill in your values, or run: bash scripts/generate-secrets.sh

# Required
JWT_SECRET=            # openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Web Push notifications (required for push notifications)
# Generate with: bash scripts/generate-secrets.sh
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Optional — AI care suggestions (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional — species search (https://perenual.com/api/auth/signup)
PERENUAL_API_KEY=

# Dev only — comma-separated hostnames the Vite dev server accepts
# ALLOWED_HOSTS=sprout.example.com
