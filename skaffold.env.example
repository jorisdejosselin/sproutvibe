# Copy to skaffold.env — Skaffold auto-loads this file, no sourcing needed.
#
# Or set these once with: skaffold config set default-repo <value> --global

# Registry prefix for built images. Skaffold rewrites all image names automatically.
# Examples:
#   ghcr.io/your_github_user
#   zot.example.com/youruser
SKAFFOLD_DEFAULT_REPO=ghcr.io/YOUR_GITHUB_USER

# Helm release name — also used as the Kubernetes namespace.
# All service names are derived from this (e.g. sprout-dev-backend, sprout-dev-postgres).
# Change this to deploy a second isolated environment (e.g. RELEASE=sprout-staging).
RELEASE=sprout-dev

# Base domain for HTTPRoute hostnames: <RELEASE>.<BASE_DOMAIN>
# With --profile postgres: <RELEASE>-postgres.<BASE_DOMAIN>
BASE_DOMAIN=example.com

# Optional: encryption key for user settings (API keys) stored in the database.
# If not set, a key is derived from JWT_SECRET automatically.
# Generate with: python3 -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# SETTINGS_ENCRYPTION_KEY=
