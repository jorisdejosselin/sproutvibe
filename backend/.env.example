JWT_SECRET=change-me-to-a-random-secret-key
DATABASE_URL=sqlite:///./sprout.db
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: pre-seed an admin account on first startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme
# ADMIN_NAME=Admin

# Optional: Perenual plant database (free key at https://perenual.com/api/auth/signup)
# PERENUAL_API_KEY=your-key-here

# Optional: Anthropic API key for AI-powered care recommendations
# ANTHROPIC_API_KEY=sk-ant-...

# Web Push (VAPID) — required for push notifications
# Generate keys with:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; import base64; k=ec.generate_private_key(ec.SECP256R1()); print('VAPID_PRIVATE_KEY='+base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).rstrip(b'=').decode()); print('VAPID_PUBLIC_KEY='+base64.urlsafe_b64encode(k.public_key().public_bytes(Encoding.X962,PublicFormat.UncompressedPoint)).rstrip(b'=').decode())"
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_EMAIL=mailto:admin@example.com
